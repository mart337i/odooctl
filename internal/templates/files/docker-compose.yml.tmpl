name: {{.EnvironmentName}}
x-odoo-common: &odoo-common
  build:
    context: .
    dockerfile: Dockerfile
    args:
      BASE_IMAGE: {{.BaseImage}}
      ODOO_VERSION: {{.OdooVersion}}
      ODOO_COMMIT: {{.OdooCommit}}
      ENTERPRISE_COMMIT: {{.EnterpriseCommit}}
{{- if .Enterprise}}
{{- if .EnterpriseGitHubToken}}
    secrets:
      - github_token
{{- else if .EnterpriseSSHKeyPath}}
    secrets:
      - enterprise_ssh_key
{{- else}}
    ssh:
      - default
{{- end}}
{{- end}}
  image: odooctl-{{.EnvironmentName}}:{{.OdooVersion}}
  depends_on:
    db:
      condition: service_healthy
  environment:
    HOST: db
    PORT: 5432
    USER: odoo
    PASSWORD: odoo
    PYTHONPATH: /opt/odoo-extra-python
{{- if .BrowserEnabled}}
    PLAYWRIGHT_BROWSERS_PATH: /opt/ms-playwright
    CHROME_BIN: /usr/local/bin/chromium
{{- end}}
  volumes:
    - {{.ProjectRoot}}:/mnt/extra-addons
    - ./odoo.conf:/etc/odoo/odoo.conf:ro
    - odoo-filestore:/var/lib/odoo/filestore
    - odoo-sessions:/var/lib/odoo/.local/share/Odoo/sessions
    - odoo-pydeps:/opt/odoo-extra-python
{{- if .BrowserEnabled}}
    - ./browser-artifacts:/browser-artifacts
{{- end}}
{{- range $i, $path := .AddonsPaths}}
    - {{$path}}:/mnt/custom-addons-{{$i}}:ro
{{- end}}
  networks:
    - odoo-network

services:
  db:
    image: postgres:15
    environment:
      POSTGRES_DB: {{.DBName}}
      POSTGRES_USER: odoo
      POSTGRES_PASSWORD: odoo
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres-data:/var/lib/postgresql/data/pgdata
    networks:
      - odoo-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U odoo -d {{.DBName}}"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 5s

  odoo-init:
    <<: *odoo-common
    profiles:
      - init
    restart: "no"
    command: ["-c", "/etc/odoo/odoo.conf", "-d", "{{.DBName}}", "-i", "{{.InitModules}}"{{if .InitDemoFlag}}, "{{.InitDemoFlag}}"{{end}}, "--stop-after-init"]

  odoo-update:
    <<: *odoo-common
    profiles:
      - update
    restart: "no"
    command: ["-c", "/etc/odoo/odoo.conf", "-d", "{{.DBName}}", "-u", "all", "--stop-after-init"]

  odoo:
    <<: *odoo-common
    ports:
      - "{{.Ports.Odoo}}:8069"
      - "{{.Ports.Debug}}:5678"
    restart: unless-stopped
    stop_grace_period: 30s
    command: ["-c", "/etc/odoo/odoo.conf"]

  mailhog:
    image: mailhog/mailhog:v1.0.1
    networks:
      - odoo-network
    restart: unless-stopped
    ports:
      - "{{.Ports.Mailhog}}:8025"
      - "{{.Ports.SMTP}}:1025"

networks:
  odoo-network:

volumes:
  postgres-data:
{{if .LegacyResources}}
    name: odoo-postgres-data-{{.VersionSuffix}}
{{end}}
  odoo-filestore:
{{if .LegacyResources}}
    name: odoo-filestore-{{.VersionSuffix}}
{{end}}
  odoo-sessions:
{{if .LegacyResources}}
    name: odoo-sessions-{{.VersionSuffix}}
{{end}}
  odoo-pydeps:
{{if .LegacyResources}}
    name: odoo-pydeps-{{.VersionSuffix}}
{{end}}
{{- if .Enterprise}}

secrets:
{{- if .EnterpriseGitHubToken}}
  github_token:
    environment: GITHUB_TOKEN
{{- else if .EnterpriseSSHKeyPath}}
  enterprise_ssh_key:
    file: {{.EnterpriseSSHKeyPath}}
{{- end}}
{{- end}}
