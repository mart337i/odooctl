ARG BASE_IMAGE=ubuntu:noble
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV LANG=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive

ARG TARGETARCH
ARG BASE_IMAGE
ARG ODOO_VERSION
ARG ODOO_COMMIT
ARG ENTERPRISE_COMMIT

RUN if [[ "${BASE_IMAGE}" == debian:buster-slim ]]; then \
        printf '%s\n' \
            'deb http://archive.debian.org/debian buster main' \
            'deb http://archive.debian.org/debian-security buster/updates main' \
            > /etc/apt/sources.list; \
        printf '%s\n' 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until; \
    fi

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        dirmngr \
        fonts-noto-cjk \
        git \
        gnupg \
        libjpeg-dev \
        libffi-dev \
        libldap2-dev \
        libpq-dev \
        libssl-dev \
        libxml2-dev \
        libxmlsec1-dev \
        libxslt1-dev \
        node-less \
        npm \
        openssh-client \
        postgresql-client \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-wheel \
{{if .UseAptOdooDependencies}}        python3-babel \
        python3-cffi \
        python3-dateutil \
        python3-decorator \
        python3-docutils \
        python3-feedparser \
        python3-gevent \
        python3-greenlet \
        python3-html2text \
        python3-jinja2 \
        python3-libsass \
        python3-lxml \
        python3-mako \
        python3-mock \
        python3-num2words \
        python3-ofxparse \
        python3-openssl \
        python3-passlib \
        python3-pil \
        python3-polib \
        python3-psutil \
        python3-psycopg2 \
        python3-pydot \
        python3-pyparsing \
        python3-pypdf2 \
        python3-qrcode \
        python3-reportlab \
        python3-requests \
        python3-serial \
        python3-setuptools \
        python3-stdnum \
        python3-suds \
        python3-usb \
        python3-vatnumber \
        python3-vobject \
        python3-werkzeug \
        python3-xlrd \
        python3-xlsxwriter \
        python3-xlwt \
        python3-zeep \
{{end}}\
        sasl2-bin \
        libsasl2-dev \
        build-essential \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN set -e; \
    if [ -z "${TARGETARCH}" ]; then TARGETARCH="$(dpkg --print-architecture)"; fi; \
    WKHTMLTOPDF_ARCH="${TARGETARCH}"; \
    WKHTMLTOPDF_RELEASE="0.12.6.1-3"; \
    WKHTMLTOPDF_BASE="jammy"; \
    WKHTMLTOPDF_SHA=""; \
    case "${BASE_IMAGE}" in \
        debian:buster-slim) WKHTMLTOPDF_RELEASE="0.12.6-1"; WKHTMLTOPDF_BASE="buster" ;; \
        ubuntu:focal) WKHTMLTOPDF_RELEASE="0.12.6-1"; WKHTMLTOPDF_BASE="focal" ;; \
    esac; \
    case "${TARGETARCH}" in \
        amd64) if [ "${WKHTMLTOPDF_BASE}" = "jammy" ]; then WKHTMLTOPDF_SHA="967390a759707337b46d1c02452e2bb6b2dc6d59"; fi ;; \
        arm64) if [ "${WKHTMLTOPDF_BASE}" = "jammy" ]; then WKHTMLTOPDF_SHA="90f6e69896d51ef77339d3f3a20f8582bdf496cc"; fi ;; \
        ppc64le|ppc64el) WKHTMLTOPDF_ARCH="ppc64el"; if [ "${WKHTMLTOPDF_BASE}" = "jammy" ]; then WKHTMLTOPDF_SHA="5312d7d34a25b321282929df82e3574319aed25c"; fi ;; \
        *) printf 'Unsupported architecture for wkhtmltopdf: %s\n' "${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --retry 5 --location \
        --output /tmp/wkhtmltox.deb \
        "https://github.com/wkhtmltopdf/packaging/releases/download/${WKHTMLTOPDF_RELEASE}/wkhtmltox_${WKHTMLTOPDF_RELEASE}.${WKHTMLTOPDF_BASE}_${WKHTMLTOPDF_ARCH}.deb"; \
    if [ -n "${WKHTMLTOPDF_SHA}" ]; then echo "${WKHTMLTOPDF_SHA} /tmp/wkhtmltox.deb" | sha1sum -c -; fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends /tmp/wkhtmltox.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/wkhtmltox.deb

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm install --global rtlcss@4.3.0 \
    && npm cache clean --force

RUN useradd --create-home --shell /bin/bash odoo \
    && mkdir -p /opt/odoo-src /opt/odoo-enterprise /opt/odoo-extra-python \
        /etc/odoo /var/lib/odoo/filestore /var/lib/odoo/.local/share/Odoo/sessions \
    && printf '%s\n' '[options]' > /etc/odoo/odoo.conf \
    && chown -R odoo:odoo /opt/odoo-extra-python /etc/odoo /var/lib/odoo

# Fetch an immutable Community revision. The commit is resolved by odooctl.
RUN test -n "${ODOO_COMMIT}" \
    && git -C /opt/odoo-src init \
    && git -C /opt/odoo-src remote add origin https://github.com/odoo/odoo.git \
    && git -C /opt/odoo-src config extensions.partialClone origin \
    && git -C /opt/odoo-src fetch --depth=1 --filter=blob:none origin "${ODOO_COMMIT}" \
    && git -C /opt/odoo-src checkout --detach FETCH_HEAD \
    && rm -rf /opt/odoo-src/.git

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv --system-site-packages /opt/odoo-venv \
    && {{if .LegacyGeventBuild}}/opt/odoo-venv/bin/pip install 'Cython<3' \
    && /opt/odoo-venv/bin/pip install --no-build-isolation{{else}}/opt/odoo-venv/bin/pip install{{end}}{{if not .UseAptOdooDependencies}} --no-cache-dir -r /opt/odoo-src/requirements.txt{{end}} \
        debugpy=={{.DebugpyVersion}} \
        ipython=={{.IPythonVersion}}{{if .IncludeLxmlHTMLClean}} \
        lxml_html_clean{{end}} \
    && printf '%s\n' \
        '#!/bin/sh' \
        'exec /opt/odoo-venv/bin/python3 /opt/odoo-src/odoo-bin "$@"' \
        > /opt/odoo-venv/bin/odoo \
    && chmod +x /opt/odoo-venv/bin/odoo

ENV PATH="/opt/odoo-venv/bin:${PATH}" \
    ODOO_RC=/etc/odoo/odoo.conf

{{if .BrowserEnabled}}
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    CHROME_BIN=/usr/local/bin/chromium

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv /opt/odoo-browser-venv \
    && /opt/odoo-browser-venv/bin/pip install playwright==1.49.1 \
    && /opt/odoo-browser-venv/bin/python3 -m playwright install --with-deps chromium \
    && CHROMIUM_PATH="$(find /opt/ms-playwright -type f -path '*/chrome-linux/chrome' | head -n 1)" \
    && test -n "${CHROMIUM_PATH}" \
    && ln -sf "${CHROMIUM_PATH}" /usr/local/bin/chromium \
    && ln -sf "${CHROMIUM_PATH}" /usr/local/bin/chromium-browser \
    && ln -sf "${CHROMIUM_PATH}" /usr/local/bin/google-chrome \
    && mkdir -p /browser-artifacts \
    && chmod -R 755 /opt/ms-playwright /browser-artifacts
{{end}}

{{if .Enterprise}}
# Fetch the matching immutable Enterprise revision using a BuildKit secret.
{{if .EnterpriseGitHubToken}}
RUN --mount=type=secret,id=github_token \
    bash -c 'test -n "${ENTERPRISE_COMMIT}"; \
        token="$(cat /run/secrets/github_token)"; \
        url="https://x-access-token:${token}@github.com/odoo/enterprise.git"; \
        git -C /opt/odoo-enterprise init; \
        git -C /opt/odoo-enterprise remote add origin "${url}"; \
        git -C /opt/odoo-enterprise config extensions.partialClone origin; \
        git -C /opt/odoo-enterprise fetch --depth=1 --filter=blob:none origin "${ENTERPRISE_COMMIT}"; \
        git -C /opt/odoo-enterprise checkout --detach FETCH_HEAD; \
        rm -rf /opt/odoo-enterprise/.git'
{{else if .EnterpriseSSHKeyPath}}
RUN --mount=type=secret,id=enterprise_ssh_key \
    bash -c 'test -n "${ENTERPRISE_COMMIT}"; \
        mkdir -p /root/.ssh; \
        ssh-keyscan github.com >> /root/.ssh/known_hosts; \
        cp /run/secrets/enterprise_ssh_key /root/.ssh/id_enterprise; \
        chmod 600 /root/.ssh/id_enterprise; \
        GIT_SSH_COMMAND="ssh -o IdentitiesOnly=yes -i /root/.ssh/id_enterprise" \
        git -C /opt/odoo-enterprise init; \
        git -C /opt/odoo-enterprise remote add origin git@github.com:odoo/enterprise.git; \
        git -C /opt/odoo-enterprise config extensions.partialClone origin; \
        GIT_SSH_COMMAND="ssh -o IdentitiesOnly=yes -i /root/.ssh/id_enterprise" \
            git -C /opt/odoo-enterprise fetch --depth=1 --filter=blob:none origin "${ENTERPRISE_COMMIT}"; \
        git -C /opt/odoo-enterprise checkout --detach FETCH_HEAD; \
        rm -rf /root/.ssh/id_enterprise /root/.ssh/known_hosts /opt/odoo-enterprise/.git'
{{else}}
RUN --mount=type=ssh \
    bash -c 'test -n "${ENTERPRISE_COMMIT}"; \
        mkdir -p /root/.ssh; \
        ssh-keyscan github.com >> /root/.ssh/known_hosts; \
        git -C /opt/odoo-enterprise init; \
        git -C /opt/odoo-enterprise remote add origin git@github.com:odoo/enterprise.git; \
        git -C /opt/odoo-enterprise config extensions.partialClone origin; \
        git -C /opt/odoo-enterprise fetch --depth=1 --filter=blob:none origin "${ENTERPRISE_COMMIT}"; \
        git -C /opt/odoo-enterprise checkout --detach FETCH_HEAD; \
        rm -rf /root/.ssh/known_hosts /opt/odoo-enterprise/.git'
{{end}}
{{end}}

COPY ./entrypoint.sh /
COPY ./wait-for-psql.py /usr/local/bin/wait-for-psql.py

RUN chown odoo:odoo /entrypoint.sh /usr/local/bin/wait-for-psql.py \
    && chmod 755 /entrypoint.sh /usr/local/bin/wait-for-psql.py \
    && chown -R odoo:odoo /opt/odoo-extra-python /var/lib/odoo

VOLUME ["/var/lib/odoo", "/mnt/extra-addons"]

EXPOSE 8069 8071 8072 5678

USER odoo
WORKDIR /mnt/extra-addons

ENTRYPOINT ["/entrypoint.sh"]
CMD ["odoo"]
